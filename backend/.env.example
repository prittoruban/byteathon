# HARVEST ZERO — Backend Environment Variables
ENVIRONMENT=development
PORT=8000

# Supabase Credentials (Required for Supabase operations)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Secret key - Backend only! Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Maps JavaScript API Key (for logistics route visualization)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
